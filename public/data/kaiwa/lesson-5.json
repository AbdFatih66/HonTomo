    "scenarios": [
        {
            "id": "l5-s1",
            "title_id": "Hari Minggu",
            "title_en": "Sunday plans",
            "setting_id": "Rekan kerja bertanya rencanamu hari Minggu.",
            "setting_en": "A colleague asks about your plans for Sunday.",
            "goal_id": "Menyebut tujuan dengan 〜へ 行きます, teman dengan 〜と, dan kendaraan dengan 〜で.",
            "goal_en": "State a destination with ~e ikimasu, a companion with ~to, and transport with ~de.",
            "patterns": [
                "(場所)へ 行きます",
                "(人)と 行きます",
                "(乗り物)で 行きます"
            ],
            "partner": {
                "name": "たなか",
                "voice": "male"
            },
            "you": {
                "name": "ブディ"
            },
            "turns": [
                {
                    "id": "l5-s1-t1",
                    "who": "partner",
                    "ja": "ブディさん、日曜日《にちようび》は どこへ 行《い》きますか。",
                    "speak": "ブディさん、にちようびは どこへ いきますか。",
                    "id_text": "Budi, hari Minggu kamu pergi ke mana?",
                    "en_text": "Budi, where are you going on Sunday?",
                    "audio": "/audio/kaiwa/lesson-5/l5-s1-t1.mp3"
                },
                {
                    "id": "l5-s1-t2",
                    "who": "you",
                    "ja": "デパートへ 行《い》きます。",
                    "speak": "デパートへ いきます。",
                    "id_text": "Aku pergi ke toserba.",
                    "en_text": "I am going to the department store.",
                    "accept": [
                        "デパートへ行きます。"
                    ],
                    "audio": "/audio/kaiwa/lesson-5/l5-s1-t2.mp3"
                },
                {
                    "id": "l5-s1-t3",
                    "who": "partner",
                    "ja": "そうですか。だれと 行《い》きますか。",
                    "speak": "そうですか。だれと いきますか。",
                    "id_text": "Oh begitu. Pergi dengan siapa?",
                    "en_text": "I see. Who are you going with?",
                    "audio": "/audio/kaiwa/lesson-5/l5-s1-t3.mp3"
                },
                {
                    "id": "l5-s1-t4",
                    "who": "you",
                    "ja": "友達《ともだち》と 行《い》きます。",
                    "speak": "ともだちと いきます。",
                    "id_text": "Aku pergi dengan teman.",
                    "en_text": "I am going with a friend.",
                    "accept": [
                        "友達と行きます。"
                    ],
                    "audio": "/audio/kaiwa/lesson-5/l5-s1-t4.mp3"
                },
                {
                    "id": "l5-s1-t5",
                    "who": "partner",
                    "ja": "電車《でんしゃ》で 行《い》きますか、バスで 行《い》きますか。",
                    "speak": "でんしゃで いきますか、バスで いきますか。",
                    "id_text": "Naik kereta atau naik bus?",
                    "en_text": "Will you go by train or by bus?",
                    "audio": "/audio/kaiwa/lesson-5/l5-s1-t5.mp3"
                },
                {
                    "id": "l5-s1-t6",
                    "who": "you",
                    "ja": "バスで 行《い》きます。",
                    "speak": "バスで いきます。",
                    "id_text": "Aku naik bus.",
                    "en_text": "I will go by bus.",
                    "accept": [
                        "バスで行きます。"
                    ],
                    "audio": "/audio/kaiwa/lesson-5/l5-s1-t6.mp3"
                },
                {
                    "id": "l5-s1-t7",
                    "who": "partner",
                    "ja": "そうですか。",
                    "speak": "そうですか。",
                    "id_text": "Oh begitu.",
                    "en_text": "I see.",
                    "audio": "/audio/kaiwa/lesson-5/l5-s1-t7.mp3"
                }
            ]
        },
