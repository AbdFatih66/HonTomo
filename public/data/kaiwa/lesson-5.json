                    "speak": "ごじに かえります。ひとりで かえります。",
                    "id_text": "Aku pulang jam 5. Aku pulang sendirian.",
                    "en_text": "I will go home at 5. I will go home alone.",
                    "accept": [
                        "5時に 帰ります。1人で 帰ります。",
                        "五時に帰ります。一人で帰ります。"
                    ],
                    "audio": "/audio/kaiwa/lesson-5/l5-s2-t6.mp3"
                },
                {
                    "id": "l5-s2-t7",
                    "who": "partner",
                    "ja": "そうですか。",
                    "speak": "そうですか。",
                    "id_text": "Oh begitu.",
                    "en_text": "I see.",
                    "audio": "/audio/kaiwa/lesson-5/l5-s2-t7.mp3"
                }
            ]
        },
