        {
            "id": "n4l21-s1",
            "title_id": "Sekarang boleh bicara?",
            "title_en": "Is now a good time?",
            "setting_id": "Telepon dari rekan kerja.",
            "setting_en": "A phone call from a coworker.",
            "goal_id": "Menyatakan sedang apa dengan Ｖている ところです.",
            "goal_en": "Say what you are in the middle of.",
            "patterns": [
                "Ｖて いる ところです"
            ],
            "partner": {
                "name": "すずき",
                "voice": "female"
            },
            "you": {
                "name": "ブディ"
            },
            "turns": [
                {
                    "id": "n4l21-s1-t1",
                    "who": "partner",
                    "ja": "もしもし、ブディさん、今《いま》 いいですか。",
                    "speak": "もしもし、ブディさん、いま いいですか。",
                    "id_text": "Halo, Budi, apakah sekarang boleh?",
                    "en_text": "Hello, Budi, is now a good time?",
                    "audio": "/audio/kaiwa/lesson-n4-21/n4l21-s1-t1.mp3"
                },
                {
                    "id": "n4l21-s1-t2",
                    "who": "you",
                    "ja": "すみません、今《いま》 ご飯《はん》を 食《た》べて いる ところです。",
                    "speak": "すみません、いま ごはんを たべて いる ところです。",
                    "id_text": "Maaf, sekarang saya sedang makan.",
                    "en_text": "Sorry, I'm in the middle of eating.",
                    "accept": [
                        "すみません、今ご飯を食べているところです。"
                    ],
                    "audio": "/audio/kaiwa/lesson-n4-21/n4l21-s1-t2.mp3"
                },
                {
                    "id": "n4l21-s1-t3",
                    "who": "partner",
                    "ja": "そうですか。 では、あとで 電話《でんわ》します。",
                    "speak": "そうですか。 では、あとで でんわします。",
                    "id_text": "Begitu ya. Kalau begitu saya telepon nanti.",
                    "en_text": "I see. Then I'll call later.",
                    "audio": "/audio/kaiwa/lesson-n4-21/n4l21-s1-t3.mp3"
                },
                {
                    "id": "n4l21-s1-t4",
                    "who": "you",
                    "ja": "はい、すぐ 終《お》わりますから、十分後《じゅっぷんご》に おねがいします。",
                    "speak": "はい、すぐ おわりますから、じゅっぷんごに おねがいします。",
                    "id_text": "Ya, sebentar lagi selesai, jadi tolong sepuluh menit lagi.",
                    "en_text": "Yes, I'll be done soon, so please call in ten minutes.",
                    "accept": [
                        "はい、すぐ終わりますから、十分後にお願いします。",
                        "はい、すぐ終わりますから、10分後にお願いします。"
                    ],
                    "audio": "/audio/kaiwa/lesson-n4-21/n4l21-s1-t4.mp3"
                },
                {
                    "id": "n4l21-s1-t5",
                    "who": "partner",
                    "ja": "わかりました。",
                    "speak": "わかりました。",
                    "id_text": "Baik.",
                    "en_text": "Understood.",
                    "audio": "/audio/kaiwa/lesson-n4-21/n4l21-s1-t5.mp3"
                },
                {
                    "id": "n4l21-s1-t6",
                    "who": "you",
                    "ja": "ありがとうございます。",
                    "speak": "ありがとうございます。",
                    "id_text": "Terima kasih.",
                    "en_text": "Thank you.",
                    "accept": [
                        "ありがとうございます。"
                    ],
                    "audio": "/audio/kaiwa/lesson-n4-21/n4l21-s1-t6.mp3"
                }
            ]
        },
        {
