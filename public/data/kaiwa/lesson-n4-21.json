                    "who": "partner",
                    "ja": "じゃ、ここで 待《ま》ちましょう。",
                    "speak": "じゃ、ここで まちましょう。",
                    "id_text": "Kalau begitu, ayo tunggu di sini.",
                    "en_text": "Then let's wait here.",
                    "audio": "/audio/kaiwa/lesson-n4-21/n4l21-s2-t5.mp3"
                },
                {
                    "id": "n4l21-s2-t6",
                    "who": "you",
                    "ja": "はい、そうしましょう。",
                    "speak": "はい、そうしましょう。",
                    "id_text": "Ya, mari.",
                    "en_text": "Yes, let's.",
                    "accept": [
                        "はい、そうしましょう。"
                    ],
                    "audio": "/audio/kaiwa/lesson-n4-21/n4l21-s2-t6.mp3"
                }
            ]
        },
