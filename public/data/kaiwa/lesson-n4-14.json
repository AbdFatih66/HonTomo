                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s4-t6.mp3"
                },
                {
                    "id": "n4l14-s4-t7",
                    "who": "partner",
                    "ja": "バスは 駅前《えきまえ》から 出《で》ますよ。",
                    "speak": "バスは えきまえから でますよ。",
                    "id_text": "Busnya berangkat dari depan stasiun.",
                    "en_text": "The bus leaves from in front of the station.",
