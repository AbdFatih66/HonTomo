{
    "id": 14,
    "level": "N4",
    "title_id": "Maaf, Terlambat",
    "title_en": "Sorry I Am Late",
    "scenarios": [
        {
            "id": "n4l14-s1",
            "title_id": "Terlambat karena kecelakaan",
            "title_en": "Late because of an accident",
            "setting_id": "Di kantor pagi hari, setelah terlambat.",
            "setting_en": "At the office in the morning, after arriving late.",
            "goal_id": "Menjelaskan alasan terlambat dengan 途中で dan Nで.",
            "goal_en": "Explain why you are late using 途中で and Nで.",
            "patterns": [
                "途中で",
                "Ｎで"
            ],
            "partner": {
                "name": "ぶちょう",
                "voice": "male"
            },
            "you": {
                "name": "ブディ"
            },
            "turns": [
                {
                    "id": "n4l14-s1-t1",
                    "who": "partner",
                    "ja": "遅《おそ》かったですね。どうしましたか。",
                    "speak": "おそかったですね。どうしましたか。",
                    "id_text": "Kamu terlambat. Ada apa?",
                    "en_text": "You are late. What happened?",
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s1-t1.mp3"
                },
                {
                    "id": "n4l14-s1-t2",
                    "who": "you",
                    "ja": "すみません。来《く》る 途中《とちゅう》で、事故《じこ》が ありました。",
                    "speak": "すみません。くる とちゅうで、じこが ありました。",
                    "id_text": "Maaf. Di tengah perjalanan ke sini ada kecelakaan.",
                    "en_text": "I am sorry. There was an accident on the way here.",
                    "accept": [
                        "すみません。来る 途中で、事故が ありました。",
                        "すみません。来る途中で事故がありました。"
                    ],
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s1-t2.mp3"
                },
                {
                    "id": "n4l14-s1-t3",
                    "who": "partner",
                    "ja": "それは 大変《たいへん》でしたね。バスですか。",
                    "speak": "それは たいへんでしたね。バスですか。",
                    "id_text": "Wah, itu repot. Bus?",
                    "en_text": "That must have been hard. Was it the bus?",
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s1-t3.mp3"
                },
                {
                    "id": "n4l14-s1-t4",
                    "who": "you",
                    "ja": "はい、バスが 止《と》まって しまったんです。",
                    "speak": "はい、バスが とまって しまったんです。",
                    "id_text": "Ya, busnya berhenti.",
                    "en_text": "Yes, the bus stopped on me.",
                    "accept": [
                        "はい、バスが 止まって しまったんです。"
                    ],
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s1-t4.mp3"
                },
                {
                    "id": "n4l14-s1-t5",
                    "who": "partner",
                    "ja": "電話《でんわ》は しましたか。",
                    "speak": "でんわは しましたか。",
                    "id_text": "Apakah kamu menelepon?",
                    "en_text": "Did you call?",
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s1-t5.mp3"
                },
                {
                    "id": "n4l14-s1-t6",
                    "who": "you",
                    "ja": "携帯電話《けいたいでんわ》を 家《いえ》に 忘《わす》れて しまいました。すみません。",
                    "speak": "けいたいでんわを いえに わすれて しまいました。すみません。",
                    "id_text": "Ponsel saya tertinggal di rumah. Maaf.",
                    "en_text": "I left my mobile phone at home. I am sorry.",
                    "accept": [
                        "携帯電話を 家に 忘れて しまいました。すみません。",
                        "携帯電話を家に忘れてしまいました。"
                    ],
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s1-t6.mp3"
                },
                {
                    "id": "n4l14-s1-t7",
                    "who": "partner",
                    "ja": "わかりました。会議《かいぎ》を 始《はじ》めましょう。",
                    "speak": "わかりました。かいぎを はじめましょう。",
                    "id_text": "Baik. Mari kita mulai rapat.",
                    "en_text": "I see. Let us start the meeting.",
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s1-t7.mp3"
                }
            ]
        },
        {
            "id": "n4l14-s2",
            "title_id": "Pulang lebih awal",
            "title_en": "Leaving early",
            "setting_id": "Di meja kerja, sore hari.",
            "setting_en": "At your desk in the afternoon.",
            "goal_id": "Meminta izin pulang dengan alasan memakai 〜ので.",
            "goal_en": "Ask permission to go home giving a reason with 〜ので.",
            "patterns": [
                "〜ので"
            ],
            "partner": {
                "name": "たなか",
                "voice": "male"
            },
            "you": {
                "name": "ブディ"
            },
            "turns": [
                {
                    "id": "n4l14-s2-t1",
                    "who": "partner",
                    "ja": "どうしましたか。",
                    "speak": "どうしましたか。",
                    "id_text": "Ada apa?",
                    "en_text": "What is it?",
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s2-t1.mp3"
                },
                {
                    "id": "n4l14-s2-t2",
                    "who": "you",
                    "ja": "熱《ねつ》が あるので、早《はや》く 帰《かえ》っても いいですか。",
                    "speak": "ねつが あるので、はやく かえっても いいですか。",
                    "id_text": "Karena demam, bolehkah saya pulang lebih awal?",
                    "en_text": "I have a fever, so may I go home early?",
                    "accept": [
                        "熱が あるので、早く 帰っても いいですか。",
                        "熱があるので、早く帰ってもいいですか。"
                    ],
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s2-t2.mp3"
                },
                {
                    "id": "n4l14-s2-t3",
                    "who": "partner",
                    "ja": "だいじょうぶですか。",
                    "speak": "だいじょうぶですか。",
                    "id_text": "Apakah baik-baik saja?",
                    "en_text": "Are you all right?",
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s2-t3.mp3"
                },
                {
                    "id": "n4l14-s2-t4",
                    "who": "you",
                    "ja": "はい、家《いえ》で 休《やす》みます。",
                    "speak": "はい、いえで やすみます。",
                    "id_text": "Ya, saya akan istirahat di rumah.",
                    "en_text": "Yes, I will rest at home.",
                    "accept": [
                        "はい、家で 休みます。",
                        "はい、家で休みます。"
                    ],
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s2-t4.mp3"
                },
                {
                    "id": "n4l14-s2-t5",
                    "who": "partner",
                    "ja": "そうですか。お大事《だいじ》に。",
                    "speak": "そうですか。おだいじに。",
                    "id_text": "Begitu. Semoga lekas sembuh.",
                    "en_text": "I see. Take care.",
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s2-t5.mp3"
                },
                {
                    "id": "n4l14-s2-t6",
                    "who": "you",
                    "ja": "ありがとう ございます。お先《さき》に 失礼《しつれい》します。",
                    "speak": "ありがとう ございます。おさきに しつれいします。",
                    "id_text": "Terima kasih. Saya pamit duluan.",
                    "en_text": "Thank you. I will leave first.",
                    "accept": [
                        "ありがとう ございます。お先に 失礼します。",
                        "ありがとうございます。お先に失礼します。"
                    ],
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s2-t6.mp3"
                },
                {
                    "id": "n4l14-s2-t7",
                    "who": "partner",
                    "ja": "お疲《つか》れさまでした。",
                    "speak": "おつかれさまでした。",
                    "id_text": "Terima kasih atas kerja kerasnya.",
                    "en_text": "Thank you for your hard work.",
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s2-t7.mp3"
                }
            ]
        },
        {
