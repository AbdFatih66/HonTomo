                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s4-t5.mp3"
                },
                {
                    "id": "n4l14-s4-t6",
                    "who": "you",
                    "ja": "じゃ、バスで 行《い》きます。",
                    "speak": "じゃ、バスで いきます。",
                    "id_text": "Kalau begitu, saya naik bus.",
