                },
                {
                    "id": "n4l14-s4-t2",
                    "who": "you",
                    "ja": "電車《でんしゃ》は まだ 動《うご》きませんか。",
                    "speak": "でんしゃは まだ うごきませんか。",
                    "id_text": "Apakah kereta belum jalan?",
                    "en_text": "Are the trains still not running?",
                    "accept": [
                        "電車は まだ 動きませんか。",
                        "電車はまだ動きませんか。"
                    ],
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s4-t2.mp3"
                },
                {
                    "id": "n4l14-s4-t3",
                    "who": "partner",
                    "ja": "ええ、事故《じこ》で、止《と》まって います。",
                    "speak": "ええ、じこで、とまって います。",
                    "id_text": "Ya, berhenti karena kecelakaan.",
                    "en_text": "Yes, they are stopped because of an accident.",
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s4-t3.mp3"
