                    "ja": "いつ 動《うご》きますか。",
                    "speak": "いつ うごきますか。",
                    "id_text": "Kapan akan jalan lagi?",
                    "en_text": "When will they run?",
                    "accept": [
                        "いつ 動きますか。",
                        "いつ動きますか。"
                    ],
                    "audio": "/audio/kaiwa/lesson-n4-14/n4l14-s4-t4.mp3"
                },
                {
                    "id": "n4l14-s4-t5",
                    "who": "partner",
                    "ja": "三十分《さんじゅっぷん》ぐらい かかります。",
                    "speak": "さんじゅっぷんぐらい かかります。",
                    "id_text": "Sekitar tiga puluh menit.",
