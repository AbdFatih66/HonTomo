                "voice": "female"
            },
            "you": {
                "name": "ブディ"
            },
            "turns": [
                {
                    "id": "n4l18-s1-t1",
                    "who": "partner",
                    "ja": "空《そら》を 見《み》て ください。どうですか。",
                    "speak": "そらを みて ください。どうですか。",
                    "id_text": "Coba lihat langit. Bagaimana?",
