                    "id": "n4l18-s1-t5",
                    "who": "partner",
                    "ja": "じゃ、コンビニへ 行《い》って、傘《かさ》を 買《か》って 来《き》て ください。",
                    "speak": "じゃ、コンビニへ いって、かさを かって きて ください。",
                    "id_text": "Kalau begitu, pergilah ke minimarket dan beli payung.",
                    "en_text": "Then go to the convenience store and buy an umbrella.",
                    "audio": "/audio/kaiwa/lesson-n4-18/n4l18-s1-t5.mp3"
                },
                {
                    "id": "n4l18-s1-t6",
                    "who": "you",
                    "ja": "はい、買《か》って 来《き》ます。",
                    "speak": "はい、かって きます。",
                    "id_text": "Baik, saya belikan.",
                    "en_text": "Yes, I will go and buy one.",
                    "accept": [
                        "はい、買って来ます。",
                        "はい、かってきます"
                    ],
                    "audio": "/audio/kaiwa/lesson-n4-18/n4l18-s1-t6.mp3"
                }
            ]
        },
